{
  "name": "mcp-agent",
  "version": "0.1.0",
  "private": true,
  "description": "An MCP-based GitHub triage and review agent with approvals, guardrails, traces and repeatable evals.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "mcp": "tsx --env-file-if-exists=.env src/mcp/server.ts",
    "mcp:inspect": "npx @modelcontextprotocol/inspector -- tsx --env-file-if-exists=.env src/mcp/server.ts",
    "agent": "tsx --env-file-if-exists=.env src/cli.ts",
    "trace": "tsx src/agent/show-trace.ts",
    "reset": "tsx --env-file-if-exists=.env src/github/reset.ts",
    "sandbox:export": "tsx src/github/export-sandbox.ts",
    "eval": "tsx --env-file-if-exists=.env evals/run.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:core": "vitest run tests/core",
    "test:specs": "vitest run tests/specs",
    "test:watch": "vitest",
    "todos": "grep -rn \"TODO(P3-\" src evals | sort",
    "progress": "node scripts/progress.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
