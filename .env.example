# Copy to .env and fill in what you need. Never commit .env.

# --- The model (needed for npm run agent and npm run eval) ---
ANTHROPIC_API_KEY=
# claude-opus-5-5 (default), claude-sonnet-5-5 or claude-haiku-4-5. Compare them with npm run eval.
ANTHROPIC_MODEL=claude-opus-5-5

# --- Which GitHub the MCP server talks to ---
# fixture: the tiny-shop sandbox in fixtures/sandbox (default, free, resettable).
# live: a real repository through the GitHub REST API. npm run agent -- --live does the same.
BACKEND=fixture

# Fixture mode only. Where the sandbox state lives (default data/state.json). npm run reset restores it.
FIXTURE_STATE=
# Fixture mode only. Make tools fail on purpose, e.g. read_file:1,search_code:2 fails the
# first call to read_file and the first two to search_code with a transient error.
FAIL_TOOLS=

# Live mode only. A fine-grained token for ONE sandbox repo: Issues read/write,
# Pull requests read/write, Contents read. See docs/LIVE_MODE.md.
GITHUB_TOKEN=
GITHUB_REPO=Tejas94/agent-sandbox

# --- Evals ---
# npm run eval exits with code 1 when the share of passed checks is below this.
EVAL_MIN_PASS=0.9

# --- Stretch (P3-07) ---
# langfuse or langsmith to also send traces to a tracing UI. Leave empty to only write traces/.
TRACE_EXPORT=
